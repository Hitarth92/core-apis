  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:show": "npm run typeorm migration:show -- -d ./src/infrastructure/persistence/type-orm.config.ts",
    "migration:up": "npm run typeorm migration:run -- -d ./src/infrastructure/persistence/type-orm.config.ts",
    "migration:generate": "npm run typeorm -- -d ./src/infrastructure/persistence/type-orm.config.ts migration:generate ./src/infrastructure/persistence/migrations/migration",
    "migration:create": "npm run typeorm -- migration:create ./src/infrastructure/persistence/migrations/migration",
    "migration:down": "npm run typeorm -- -d ./src/infrastructure/persistence/type-orm.config.ts migration:revert",
    "schema:drop": "npm run typeorm -- -d ./src/infrastructure/persistence/type-orm.config.ts schema:drop"
  },
